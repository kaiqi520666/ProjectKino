# 运行环境：development / production
FRAMEDRAMA_ENVIRONMENT=development
FRAMEDRAMA_LOG_LEVEL=INFO

# PostgreSQL（异步 asyncpg；密码含特殊字符请做 URL 编码）
# 方式 A：复用宿主机已有 PostgreSQL，新建 framedrama 数据库
# 方式 B：使用 compose.yaml 拉起独立容器（默认端口 5433，避免与宿主机 5432 冲突）
FRAMEDRAMA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/framedrama

# Redis（建议使用独立 DB 号，如 5，与 Moonflow 隔离）
FRAMEDRAMA_REDIS_URL=redis://127.0.0.1:6379/5
FRAMEDRAMA_REDIS_KEY_PREFIX=framedrama:

# CORS 允许的前端地址（JSON 数组）
FRAMEDRAMA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:5174","http://localhost:5174"]

# 会话有效期（秒，默认 7 天）
FRAMEDRAMA_SESSION_TTL_SECONDS=604800

# FFmpeg / ffprobe 路径（留空则从 PATH 读取）
FRAMEDRAMA_FFMPEG_PATH=ffmpeg
FRAMEDRAMA_FFPROBE_PATH=ffprobe

# 沧元批量生图 / CC 批量生视频默认并发上限（防触发上游 429 限流）
FRAMEDRAMA_IMAGE_CONCURRENCY=4
FRAMEDRAMA_VIDEO_CONCURRENCY=3
